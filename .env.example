# Solo desarrollo local. No reutilizar estas credenciales en producción.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
APP_TIME_ZONE=America/Merida
POSTGRES_DB=asistencia
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=asistencia_local_only
POSTGRES_PORT=55432
POSTGRES_TEST_PORT=55433
DATABASE_URL=postgresql://asistencia:asistencia_local_only@127.0.0.1:55432/asistencia
TEST_DATABASE_URL=postgresql://asistencia:asistencia_local_only@127.0.0.1:55433/asistencia_test
# Vite proxy de desarrollo; no se expone al bundle del navegador.
API_PROXY_TARGET=http://127.0.0.1:3001

APP_ORIGIN=http://127.0.0.1:5173
SESSION_HOURS=8

# Avisos internos persistentes; false para desactivar la entrega, conserva outbox.
NOTIFICATION_WORKER_ENABLED=true

# Evaluación automática de asistencia con hora del servidor.
ATTENDANCE_WORKER_ENABLED=true
ATTENDANCE_EVALUATION_INTERVAL_SECONDS=60
